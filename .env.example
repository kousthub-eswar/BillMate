# BillMate Environment Configuration Example
# Copy this file to .env.local for local development or set these variables in your CI/CD platform

# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Client Anon / Publishable Key (safe for frontend use with RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
